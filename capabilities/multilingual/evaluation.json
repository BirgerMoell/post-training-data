    {"id": "tier-parity", "name": "Language tier and fidelity audit", "source_url": null, "catalogue_entry": "birgermoell-oellm-eu-eval-holdouts-v1/0.0.0/README.md", "type": "project-holdout", "primary": true, "gate_class": "release", "gate_eligible": true, "separation_evidence": "Use unique protected prompts per language and keep translations, prompts, answers, and source passages outside all training builders.", "runner": "custom", "language_scope": "37 release locales / 36 language identities", "metrics": [
