      {"id": "eu-mmlu-min", "name": "EU MMLU minimum language", "unit": "score", "direction": "higher", "operator": ">=", "targets": {"9b": {"committed": 55, "stretch": 72}, "30b": {"committed": 65, "stretch": 72}}},
