  "suites": [
    {"id": "knowledge-eu", "name": "MMLU-ProX, EU MMLU, MMMLU, and INCLUDE", "source_url": "https://github.com/OpenEuroLLM/oellm-eval", "catalogue_entry": "birgermoell-oellm-eu-eval-holdouts-v1/0.0.0/README.md", "type": "project-holdout", "primary": true, "gate_class": "headline", "gate_eligible": true, "separation_evidence": "Use the evaluation-only project bundle or another immutable clean split. Public Global-MMLU/MMMLU copies are diagnostic if any exact items entered earlier runs.", "runner": "oellm-eval", "language_scope": "EU24 plus release-language extensions", "metrics": [
