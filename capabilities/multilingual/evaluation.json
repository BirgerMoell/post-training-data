    ], "cadence": ["base", "after multilingual SFT", "after every alignment stage", "release candidate"], "notes": "Public benchmark results must be labeled diagnostic wherever training overlap cannot be excluded."},
    {"id": "euroeval", "name": "EuroEval leaderboard", "source_url": "https://euroeval.com/", "catalogue_entry": null, "type": "public-benchmark", "primary": true, "gate_class": "headline", "gate_eligible": false, "separation_evidence": "External leaderboard is valuable for comparison, but test opacity, version drift, and possible source overlap prevent it from being the sole release gate.", "runner": "EuroEval", "language_scope": "supported European languages", "metrics": [{"id": "rank", "name": "overall leaderboard rank", "unit": "rank", "direction": "lower", "operator": "rank<=", "targets": {"9b": {"committed": 10, "stretch": 3}, "30b": {"committed": 5, "stretch": 3}}}], "cadence": ["major checkpoint", "release candidate"], "notes": "Record evaluation date, leaderboard version, compared model class, and per-language rank."},
